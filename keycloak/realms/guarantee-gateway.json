{
  "realm": "guarantee-gateway",
  "displayName": "Credeq Guarantee Gateway",
  "displayNameHtml": "<strong>Credeq</strong> Guarantee Gateway",
  "enabled": true,
  "sslRequired": "external",

  "registrationAllowed": false,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "verifyEmail": false,
  "editUsernameAllowed": false,
  "rememberMe": false,

  "accessTokenLifespan": 300,
  "accessTokenLifespanForImplicitFlow": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 2592000,
  "offlineSessionMaxLifespanEnabled": true,
  "offlineSessionMaxLifespan": 5184000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "accessCodeLifespan": 60,
  "accessCodeLifespanUserAction": 300,
  "actionTokenGeneratedByUserLifespan": 300,

  "bruteForceProtected": true,
  "permanentLockout": true,
  "failureFactor": 3,
  "maxTemporaryLockouts": 0,
  "quickLoginCheckMilliSeconds": 1000,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,

  "passwordPolicy": "length(12) and upperCase(1) and lowerCase(1) and digits(1) and specialChars(1) and notUsername(undefined) and passwordHistory(3)",

  "eventsEnabled": true,
  "eventsExpiration": 604800,
  "eventsListeners": ["jboss-logging"],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,

  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "no-reply@credeq-poc.local",
    "fromDisplayName": "Credeq Guarantee Gateway",
    "ssl": "false",
    "starttls": "false",
    "auth": "false"
  },

  "browserFlow": "guarantee-gateway-browser",

  "authenticationFlows": [
    {
      "alias": "guarantee-gateway-browser",
      "description": "design.md §5: Cookie (ALTERNATIVE) -> Forms (ALTERNATIVE) [Username Password Form -> Email OTP]. Built-in authenticators plus the pinned email-OTP extension; no custom code.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "authenticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "guarantee-gateway-forms",
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "authenticatorFlow": true,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "guarantee-gateway-forms",
      "description": "Password then email OTP. Both REQUIRED, so failures at either step feed the same brute-force counter.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticator": "email-otp-authenticator",
          "authenticatorConfig": "guarantee-gateway-email-otp",
          "requirement": "REQUIRED",
          "priority": 20,
          "authenticatorFlow": false,
          "userSetupAllowed": false
        }
      ]
    }
  ],

  "authenticatorConfig": [
    {
      "alias": "guarantee-gateway-email-otp",
      "config": {
        "length": "6",
        "ttl": "300",
        "forceSecondFactor": "true"
      }
    }
  ],

  "roles": {
    "realm": [
      {
        "name": "facility-holder",
        "description": "Facility holder - can view and manage their own guarantee facilities."
      },
      {
        "name": "broker",
        "description": "Broker - acts on behalf of facility holders."
      }
    ]
  },

  "groups": [
    {
      "name": "facility-holders",
      "path": "/facility-holders",
      "realmRoles": ["facility-holder"]
    },
    {
      "name": "brokers",
      "path": "/brokers",
      "realmRoles": ["broker"]
    },
    {
      "name": "support-desk",
      "path": "/support-desk",
      "clientRoles": {
        "realm-management": ["view-realm", "view-users", "manage-users", "view-events"]
      }
    }
  ],

  "clientScopes": [
    {
      "name": "guarantee-gateway-api-audience",
      "description": "Adds guarantee-gateway-api to the access token audience so the API can enforce an aud check.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "guarantee-gateway-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "guarantee-gateway-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],

  "clients": [
    {
      "clientId": "guarantee-gateway-za",
      "name": "Guarantee Gateway Portal (ZA)",
      "description": "Angular SPA - public client, Authorization Code + PKCE (S256).",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "rootUrl": "http://localhost:4200",
      "baseUrl": "/",
      "redirectUris": ["http://localhost:4200/*"],
      "webOrigins": ["http://localhost:4200"],
      "fullScopeAllowed": false,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*",
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false",
        "backchannel.logout.session.required": "true"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "basic",
        "email",
        "guarantee-gateway-api-audience"
      ],
      "optionalClientScopes": ["address", "phone"]
    },
    {
      "clientId": "guarantee-gateway-api",
      "name": "Guarantee Gateway API",
      "description": "Resource server. Validates bearer JWTs only - no flows enabled; exists so tokens carry a meaningful aud claim.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false
    },
    {
      "clientId": "marshall-provisioning",
      "name": "Marshall Provisioning Service",
      "description": "Marshall mock's Admin API identity. Least privilege: realm-management manage-users/view-users/view-realm. Those roles need BOTH a user role-mapping and a clientScopeMappings entry - with fullScopeAllowed=false they are otherwise stripped from the token.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "$(env:MARSHALL_CLIENT_SECRET)",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false
    }
  ],

  "scopeMappings": [
    {
      "client": "guarantee-gateway-za",
      "roles": ["facility-holder", "broker"]
    }
  ],

  "clientScopeMappings": {
    "realm-management": [
      {
        "client": "marshall-provisioning",
        "roles": ["manage-users", "view-users", "view-realm"]
      }
    ]
  },

  "users": [
    {
      "username": "thabo.mokoena@example.com",
      "email": "thabo.mokoena@example.com",
      "firstName": "Thabo",
      "lastName": "Mokoena",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "$(env:POC_TEST_PASSWORD)",
          "temporary": false
        }
      ],
      "realmRoles": ["facility-holder"],
      "groups": ["/facility-holders"]
    },
    {
      "username": "lerato.dlamini@example.com",
      "email": "lerato.dlamini@example.com",
      "firstName": "Lerato",
      "lastName": "Dlamini",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "$(env:POC_TEST_PASSWORD)",
          "temporary": false
        }
      ],
      "realmRoles": ["broker"],
      "groups": ["/brokers"]
    },
    {
      "username": "service-account-marshall-provisioning",
      "enabled": true,
      "serviceAccountClientId": "marshall-provisioning",
      "clientRoles": {
        "realm-management": ["manage-users", "view-users", "view-realm"]
      }
    }
  ]
}
