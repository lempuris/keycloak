# Copy to `.env` and adjust. `.env` is git-ignored and must never be committed.
# This mirrors the Key Vault discipline from design.md §7: no secrets in Git.

# --- PostgreSQL ---
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=local-dev-only-change-me

# --- Keycloak bootstrap admin (master realm) ---
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=local-dev-only-change-me

# --- Logging ---
# `default` = human-readable. Switch to `json` for the Phase 6 audit-log path.
KC_LOG_CONSOLE_OUTPUT=default

# --- Seed user credentials (used by the realm config and smoke test) ---
# Must satisfy the realm password policy: length(12) upper lower digit special.
# Referenced from the realm JSON as $(env:POC_TEST_PASSWORD) rather than being
# hardcoded there - the local stand-in for a Key Vault secret reference.
POC_TEST_USER=thabo.mokoena@example.com
POC_TEST_PASSWORD=PocDemo!2026x
POC_BROKER_USER=lerato.dlamini@example.com

# --- Marshall provisioning service account (Phase 5) ---
# Secret for the `marshall-provisioning` service-account client. Scoped to
# realm-management/manage-users - deliberately not the master admin.
MARSHALL_CLIENT_SECRET=local-dev-only-change-me

# Broker that test-provisioning.ps1 creates and tears down through the mock.
# Must not collide with a seeded user; the test deletes it when it finishes.
POC_PROVISIONED_USER=sipho.ndlovu@example.com
